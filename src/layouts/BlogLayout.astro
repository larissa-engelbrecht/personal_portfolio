---
import Layout from "./Layout.astro";
import { Image } from "astro:assets";
// Removed Nav import
import Footer from "@/components/footer.astro";

interface Props {
  title: string;
  description: string;
  publishDate: Date;
  updatedDate?: Date;
  image: any;
  tags?: string[];
}

const { title, description, publishDate, updatedDate, image, tags } =
  Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
  });
}

// Calculate reading time (rough estimate based on word count)
const content = await Astro.slots.render("default");
const wordCount = content.split(/\s+/).length;
const readingTime = Math.ceil(wordCount / 200); // Average reading speed: 200 words/min
---

<Layout title={title} description={description}>
  <article class="max-w-4xl mx-auto px-4 pt-36 pb-20">
    <div class="mb-8 flex items-center gap-6">
      <a
        href="/"
        class="flex items-center gap-2 text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            d="M21 20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V9.48907C3 9.18048 3.14247 8.88917 3.38606 8.69972L11.3861 2.47749C11.7472 2.19663 12.2528 2.19663 12.6139 2.47749L20.6139 8.69972C20.8575 8.88917 21 9.18048 21 9.48907V20ZM19 19V9.97815L12 4.53371L5 9.97815V19H19Z"
          ></path>
        </svg>
        Back to Home
      </a>

      <a
        href="/blog"
        class="flex items-center gap-2 text-[var(--white-icon)] hover:text-[var(--sec)] transition-colors"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6" />
        </svg>
        Back to Blog
      </a>
    </div>

    {
      image && (
        <figure class="mb-8 rounded-2xl overflow-hidden">
          <Image
            src={image}
            alt={title}
            class="w-full aspect-video object-cover"
            width={1200}
            height={630}
          />
        </figure>
      )
    }

    <header class="mb-8">
      <h1 class="text-5xl font-bold mb-4 text-[var(--sec)] shiny-sec">
        {title}
      </h1>
      <p class="text-xl text-[var(--white-icon)] mb-4">{description}</p>

      <div
        class="flex flex-wrap items-center gap-4 text-sm text-[var(--white-icon)]"
      >
        <time datetime={publishDate.toISOString()}>
          {formatDate(publishDate)}
        </time>
        <span class="text-[var(--sec)]">•</span>
        <span>{readingTime} min read</span>
        {
          updatedDate && (
            <>
              <span class="text-[var(--sec)]">•</span>
              <span>Updated: {formatDate(updatedDate)}</span>
            </>
          )
        }
      </div>

      </header>

    <hr class="border-t border-[#ffffff10] my-8" />

    <div
      class="max-w-none leading-7
      text-[var(--white-icon)]
      [&_h1]:text-[var(--white)] [&_h2]:text-[var(--white)] [&_h3]:text-[var(--white)] [&_h4]:text-[var(--white)]
      [&_h1]:text-4xl [&_h1]:font-bold [&_h1]:mt-8 [&_h1]:mb-4
      [&_h2]:text-3xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-4
      [&_h3]:text-2xl [&_h3]:font-bold [&_h3]:mt-8 [&_h3]:mb-4
      [&_h4]:text-xl [&_h4]:font-bold [&_h4]:mt-8 [&_h4]:mb-4
      [&_h5]:text-lg [&_h5]:font-bold [&_h5]:mt-8 [&_h5]:mb-4
      [&_h6]:text-base [&_h6]:font-bold [&_h6]:mt-8 [&_h6]:mb-4
      [&_p]:mb-4
      [&_a]:text-[var(--sec)] [&_a]:underline
      [&_ul]:mb-4 [&_ul]:ml-6 [&_ul]:list-disc [&_ul]:list-outside
      [&_ol]:mb-4 [&_ol]:ml-6 [&_ol]:list-decimal [&_ol]:list-outside
      [&_li]:mb-2
      [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:rounded [&_code]:text-sm [&_code]:font-mono [&_code]:bg-[#1414149c] [&_code]:text-[var(--white)]
      [&_pre]:p-4 [&_pre]:rounded-lg [&_pre]:overflow-x-auto [&_pre]:mb-4 [&_pre]:bg-[var(--background)]
      [&_pre_code]:bg-transparent [&_pre_code]:p-0
      [&_blockquote]:border-l-4 [&_blockquote]:border-[var(--sec)] [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:my-4
      [&_img]:rounded-lg [&_img]:my-6"
    >
      <slot />
    </div>

    <hr class="border-t border-[#ffffff10] mt-12 mb-8" />

    <div class="text-center mt-8">
      <a
        href="/blog"
        class="inline-block py-3 px-5 rounded-xl bg-[#1414149c] text-[var(--sec)] font-medium hover:bg-[var(--white-icon-tr)] transition-all border border-[var(--white-icon-tr)]"
      >
        View All Posts
      </a>
    </div>
  </article>
  <Footer />
</Layout>